rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function member(coupleId) { return signedIn() && userDoc().data.coupleId == coupleId; }
    function owner() { return signedIn() && (resource.data.createdBy == request.auth.uid || resource.data.senderId == request.auth.uid || resource.data.uid == request.auth.uid); }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow read: if member(coupleId);
      allow create: if signedIn() && request.resource.data.memberIds is list && request.auth.uid in request.resource.data.memberIds;
      allow update: if member(coupleId);
      allow delete: if false;

      match /settings/{settingId} {
        allow read, write: if member(coupleId);
      }

      match /_indexes/{indexId} {
        allow read, write: if member(coupleId);
      }

      match /{collection}/{itemId} {
        allow read: if member(coupleId) ||
          (collection == 'timeline' && resource.data.visibility == 'PUBLIC') ||
          (collection == 'memories' && resource.data.visibility == 'PUBLIC') ||
          (collection == 'guestMessages' && resource.data.status == 'approved');
        allow create: if member(coupleId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(coupleId) && (resource.data.createdBy == request.auth.uid || collection in ['guestMessages', 'timeline', 'memories']);
        allow delete: if member(coupleId) && (resource.data.createdBy == request.auth.uid || collection == 'guestMessages');
      }
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function member(coupleId) {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.coupleId == coupleId;
    }

    match /couples/{coupleId}/{allPaths=**} {
      allow read: if member(coupleId);
      allow write: if member(coupleId)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|audio/(mpeg|wav|ogg))');
      allow delete: if member(coupleId);
    }
  }
}
